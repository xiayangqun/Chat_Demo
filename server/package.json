{
  "name": "chat-demo-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate-proto": "bash ../scripts/generate-proto.sh",
    "dev": "tsx watch src/index.ts",
    "build": "bash ../scripts/generate-proto-server.sh && tsc && cp src/graphql/schema.graphql dist/graphql/ && cp src/generated/chat_realtime_pb.js dist/generated/",
    "start": "node dist/index.js",
    "seed": "tsx src/seed/seedDatabase.ts"
  },
  "dependencies": {
    "@apollo/server": "^4.11.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "graphql": "^16.9.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "protobufjs": "^7.4.0",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.0",
    "nodemon": "^3.1.7",
    "protobufjs-cli": "^1.3.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
